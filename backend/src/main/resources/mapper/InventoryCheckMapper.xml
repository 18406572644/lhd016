<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bike.mapper.InventoryCheckMapper">

    <resultMap id="BaseResultMap" type="com.bike.entity.InventoryCheck">
        <id column="id" property="id"/>
        <result column="check_no" property="checkNo"/>
        <result column="supply_point_id" property="supplyPointId"/>
        <result column="supply_point_name" property="supplyPointName"/>
        <result column="check_date" property="checkDate"/>
        <result column="checker" property="checker"/>
        <result column="status" property="status"/>
        <result column="total_items" property="totalItems"/>
        <result column="diff_count" property="diffCount"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <select id="selectPageByCondition" resultMap="BaseResultMap">
        SELECT * FROM inventory_check
        <where>
            <if test="params.checkNo != null and params.checkNo != ''">
                AND check_no LIKE '%' || #{params.checkNo} || '%'
            </if>
            <if test="params.supplyPointId != null">
                AND supply_point_id = #{params.supplyPointId}
            </if>
            <if test="params.startDate != null">
                AND check_date &gt;= #{params.startDate}
            </if>
            <if test="params.endDate != null">
                AND check_date &lt;= #{params.endDate}
            </if>
            <if test="params.status != null and params.status != ''">
                AND status = #{params.status}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

    <select id="countTodayChecks" resultType="java.lang.Long">
        SELECT COUNT(*) FROM inventory_check WHERE check_date = #{today}
    </select>

    <select id="generateCheckNo" resultType="java.lang.String">
        SELECT CONCAT('PD', FORMATDATETIME(CURRENT_DATE, 'yyyyMMdd'), 
               LPAD(COALESCE(MAX(CAST(SUBSTRING(check_no, 11) AS INTEGER)), 0) + 1, 3, '0'))
        FROM inventory_check
        WHERE check_no LIKE CONCAT('PD', FORMATDATETIME(CURRENT_DATE, 'yyyyMMdd'), '%')
    </select>
</mapper>
