<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bike.mapper.SupplyPointMapper">

    <resultMap id="BaseResultMap" type="com.bike.entity.SupplyPoint">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="address" property="address"/>
        <result column="type" property="type"/>
        <result column="status" property="status"/>
        <result column="area" property="area"/>
        <result column="contact_person" property="contactPerson"/>
        <result column="contact_phone" property="contactPhone"/>
        <result column="longitude" property="longitude"/>
        <result column="latitude" property="latitude"/>
        <result column="description" property="description"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectPageByCondition" resultMap="BaseResultMap">
        SELECT * FROM supply_point
        <where>
            <if test="params.name != null and params.name != ''">
                AND name LIKE '%' || #{params.name} || '%'
            </if>
            <if test="params.area != null and params.area != ''">
                AND area = #{params.area}
            </if>
            <if test="params.type != null and params.type != ''">
                AND type = #{params.type}
            </if>
            <if test="params.status != null and params.status != ''">
                AND status = #{params.status}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>
</mapper>
