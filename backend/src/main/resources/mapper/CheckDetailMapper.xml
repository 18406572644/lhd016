<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bike.mapper.CheckDetailMapper">

    <resultMap id="BaseResultMap" type="com.bike.entity.CheckDetail">
        <id column="id" property="id"/>
        <result column="check_id" property="checkId"/>
        <result column="part_id" property="partId"/>
        <result column="part_name" property="partName"/>
        <result column="system_quantity" property="systemQuantity"/>
        <result column="actual_quantity" property="actualQuantity"/>
        <result column="diff_quantity" property="diffQuantity"/>
    </resultMap>

    <select id="selectByCheckId" resultMap="BaseResultMap">
        SELECT * FROM check_detail WHERE check_id = #{checkId} ORDER BY id ASC
    </select>

    <delete id="deleteByCheckId">
        DELETE FROM check_detail WHERE check_id = #{checkId}
    </delete>
</mapper>
