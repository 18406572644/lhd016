<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bike.mapper.HelpStatusFlowMapper">

    <resultMap id="BaseResultMap" type="com.bike.entity.HelpStatusFlow">
        <id column="id" property="id"/>
        <result column="help_request_id" property="helpRequestId"/>
        <result column="from_status" property="fromStatus"/>
        <result column="to_status" property="toStatus"/>
        <result column="operator" property="operator"/>
        <result column="operate_time" property="operateTime"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <select id="selectByHelpRequestId" resultMap="BaseResultMap">
        SELECT * FROM help_status_flow
        WHERE help_request_id = #{helpRequestId}
        ORDER BY operate_time ASC
    </select>

</mapper>
